      "title": "PlanningRequestProposal",
      "type": "object"
    },
    "StrategyPlanProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Depends On",
          "type": "array"
        },
        "planning_request_id": {
          "title": "Planning Request Id",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "planning_request_id",
        "plan_id"
      ],
      "title": "StrategyPlanProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "branch_id": {
      "title": "Branch Id",
      "type": "string"
    },
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "sim_time_us": {
      "minimum": 0,
      "title": "Sim Time Us",
      "type": "integer"
    },
    "decision_triggers": {
      "items": {
        "$ref": "#/$defs/DecisionTrigger"
      },
      "maxItems": 32,
      "title": "Decision Triggers",
      "type": "array"
    },
    "base_agent_revision": {
      "minimum": 0,
      "title": "Base Agent Revision",
      "type": "integer"
    },
    "component_dependencies": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "enum": [
          "memory",
          "belief",
          "planning",
          "strategy",
          "cursor",
          "budget",
          "attention"
        ]
      },
      "title": "Component Dependencies",
      "type": "object"
    },
    "memory_proposals": {
      "items": {
        "$ref": "#/$defs/MemoryProposal"
      },
      "maxItems": 64,
      "title": "Memory Proposals",
      "type": "array"
    },
    "belief_proposals": {
      "items": {
        "$ref": "#/$defs/BeliefProposal"
      },
      "maxItems": 64,
      "title": "Belief Proposals",
      "type": "array"
    },
    "planning_request_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanningRequestProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "strategy_plan_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrategyPlanProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "action_proposals": {
      "items": {
        "$ref": "#/$defs/ActionProposal"
      },
      "maxItems": 32,
      "title": "Action Proposals",
      "type": "array"
    },
    "rationale": {
      "$ref": "#/$defs/DecisionRationale"
    },
    "original_decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Decision Id"
    },
    "planning_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planning Request Id"
    },
    "schema_version": {
      "const": "agent-decision.v0.1",
      "default": "agent-decision.v0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "branch_id",
    "agent_id",
    "observation_id",
    "sim_time_us",
    "base_agent_revision"
  ],
  "title": "AgentDecision",
  "type": "object"
}
