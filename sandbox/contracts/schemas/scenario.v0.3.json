    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "rule",
            "replay",
            "openai"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "title": "Role Tags",
          "type": "array"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "token_balance": {
          "minimum": 0,
          "title": "Token Balance",
          "type": "integer"
        },
        "usdx_balance": {
          "minimum": 0,
          "title": "Usdx Balance",
          "type": "integer"
        },
        "configuration_provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigurationProvenance"
          },
          "title": "Configuration Provenance",
          "type": "object"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "strategy",
        "token_balance",
        "usdx_balance"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentConfigurationDraft": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "input_mode": {
          "enum": [
            "preset",
            "random",
            "natural_language",
            "detailed"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "public_identity": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Identity"
        },
        "strategy": {
          "anyOf": [
            {
              "enum": [
                "rule",
                "replay",
                "openai"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "archetype_ids": {
          "items": {
            "enum": [
              "ordinary_participant",
              "capital_holder",
              "liquidity_provider",
              "asset_issuer",
              "information_participant"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Archetype Ids",
          "type": "array"
        },
        "role_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 16,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Tags"
        },
        "capability_set": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Set"
        },
        "base_persona": {
          "$ref": "#/$defs/BasePersonaDraft"
        },
        "cognitive_profile": {
          "$ref": "#/$defs/CognitiveProfileDraft"
        },
        "attention_profile": {
          "$ref": "#/$defs/AttentionProfileDraft"
        },
        "latency_profile": {
          "$ref": "#/$defs/LatencyProfileDraft"
        },
        "planner_profile_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planner Profile Id"
        },
        "portfolio": {
          "$ref": "#/$defs/AgentPortfolioDraft"
        },
        "random_fields": {
          "items": {
            "enum": [
              "base_persona.risk_tolerance_milli",
              "base_persona.time_horizon",
              "base_persona.loss_aversion_milli",
              "base_persona.trend_bias_milli",
              "base_persona.skepticism_milli",
              "base_persona.communication_propensity_milli",
              "cognitive_profile.context_capacity",
              "cognitive_profile.memory_search_limit",
              "attention_profile.information_capacity",
              "attention_profile.minimum_salience",
              "latency_profile.planning_latency_us",
              "latency_profile.action_latency_us"
