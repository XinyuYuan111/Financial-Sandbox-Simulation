            "type": "string"
          },
          "maxItems": 32,
          "title": "Random Fields",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigurationProvenance"
          },
          "title": "Provenance",
          "type": "object"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/ConfigurationSuggestion"
          },
          "maxItems": 32,
          "title": "Suggestions",
          "type": "array"
        },
        "accepted_suggestion_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Accepted Suggestion Ids",
          "type": "array"
        },
        "declined_suggestion_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Declined Suggestion Ids",
          "type": "array"
        },
        "ambiguities": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Ambiguities",
          "type": "array"
        },
        "schema_version": {
          "const": "agent-configuration-draft.v0.1",
          "default": "agent-configuration-draft.v0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "input_mode"
      ],
      "title": "AgentConfigurationDraft",
      "type": "object"
    },
