{
  "$defs": {
    "AttentionProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "attention.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "information_capacity": {
          "default": 20,
          "maximum": 10000,
          "minimum": 1,
          "title": "Information Capacity",
          "type": "integer"
        },
        "minimum_salience": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Salience",
          "type": "integer"
        }
      },
      "title": "AttentionProfile",
      "type": "object"
    },
    "BasePersona": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "const": "persona.v0.1",
          "default": "persona.v0.1",
          "title": "Template Version",
          "type": "string"
        },
        "private_goals": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Private Goals",
          "type": "array"
        },
        "risk_tolerance_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Risk Tolerance Milli",
          "type": "integer"
        },
        "time_horizon": {
          "enum": [
            "short",
            "medium",
            "long"
          ],
          "title": "Time Horizon",
          "type": "string"
        },
        "loss_aversion_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Loss Aversion Milli",
          "type": "integer"
        },
        "trend_bias_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Trend Bias Milli",
          "type": "integer"
        },
        "skepticism_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Skepticism Milli",
          "type": "integer"
        },
        "communication_propensity_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Communication Propensity Milli",
          "type": "integer"
        },
        "bounded_notes": {
          "default": "",
          "maxLength": 500,
          "title": "Bounded Notes",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "risk_tolerance_milli",
        "time_horizon",
        "loss_aversion_milli",
        "trend_bias_milli",
        "skepticism_milli",
        "communication_propensity_milli"
      ],
      "title": "BasePersona",
      "type": "object"
    },
    "CognitiveProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "cognitive.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "max_plans_per_window": {
          "default": 2,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Plans Per Window",
          "type": "integer"
        },
        "planning_window_us": {
          "default": 30000000,
          "minimum": 1,
          "title": "Planning Window Us",
          "type": "integer"
        },
        "context_capacity": {
          "default": 8000,
          "maximum": 1000000,
          "minimum": 256,
          "title": "Context Capacity",
          "type": "integer"
        },
        "memory_search_limit": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Memory Search Limit",
          "type": "integer"
        }
      },
      "title": "CognitiveProfile",
      "type": "object"
    },
    "ConfigurationProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "default",
            "archetype",
            "random",
            "user",
            "llm_interpreted"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "distribution_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution Version"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "interpreter_request_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpreter Request Id"
        },
        "user_confirmed": {
          "default": false,
          "title": "User Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "source"
      ],
      "title": "ConfigurationProvenance",
      "type": "object"
    },
    "LatencyProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "latency.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "planning_latency_us": {
          "default": 1000000,
          "minimum": 0,
          "title": "Planning Latency Us",
          "type": "integer"
        },
        "action_latency_us": {
          "default": 1000000,
          "minimum": 0,
          "title": "Action Latency Us",
          "type": "integer"
        }
      },
      "title": "LatencyProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "public_identity": {
      "default": "",
      "maxLength": 500,
      "title": "Public Identity",
      "type": "string"
    },
    "role_tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Role Tags",
      "type": "array"
    },
    "capability_set": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Capability Set",
      "type": "array"
    },
    "base_persona": {
      "$ref": "#/$defs/BasePersona"
    },
    "planner_profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Planner Profile Id",
      "type": "string"
    },
    "controller_profile_id": {
      "default": "declarative_market.v0.1",
      "maxLength": 128,
      "minLength": 1,
      "title": "Controller Profile Id",
      "type": "string"
    },
    "cognitive_profile": {
      "$ref": "#/$defs/CognitiveProfile"
    },
    "attention_profile": {
      "$ref": "#/$defs/AttentionProfile"
    },
    "latency_profile": {
      "$ref": "#/$defs/LatencyProfile"
    },
    "configuration_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigurationProvenance"
      },
      "title": "Configuration Provenance",
      "type": "object"
    },
    "schema_version": {
      "const": "agent-definition.v0.2",
      "default": "agent-definition.v0.2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "display_name",
    "base_persona",
    "planner_profile_id"
  ],
  "title": "AgentDefinition",
  "type": "object"
}
