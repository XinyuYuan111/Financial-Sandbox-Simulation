{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "rule",
            "replay",
            "openai",
            "background"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "title": "Role Tags",
          "type": "array"
        },
        "funding_profile": {
          "title": "Funding Profile",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "token_balance": {
          "minimum": 0,
          "title": "Token Balance",
          "type": "integer"
        },
        "usdx_balance": {
          "minimum": 0,
          "title": "Usdx Balance",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "strategy",
        "funding_profile",
        "token_balance",
        "usdx_balance"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "public_identity": {
          "default": "",
          "maxLength": 500,
          "title": "Public Identity",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Role Tags",
          "type": "array"
        },
        "funding_profile": {
          "enum": [
            "ordinary",
            "capital",
            "liquidity",
            "issuer",
            "information"
          ],
          "title": "Funding Profile",
          "type": "string"
        },
        "capability_set": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Capability Set",
          "type": "array"
        },
        "base_persona": {
          "$ref": "#/$defs/BasePersona"
        },
        "planner_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Planner Profile Id",
          "type": "string"
        },
        "controller_profile_id": {
          "default": "declarative_market.v0.1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Controller Profile Id",
          "type": "string"
        },
        "cognitive_profile": {
          "$ref": "#/$defs/CognitiveProfile"
        },
        "attention_profile": {
          "$ref": "#/$defs/AttentionProfile"
        },
        "latency_profile": {
          "$ref": "#/$defs/LatencyProfile"
        },
        "schema_version": {
          "const": "agent-definition.v0.1",
          "default": "agent-definition.v0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "funding_profile",
        "base_persona",
        "planner_profile_id"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AttentionProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "attention.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "information_capacity": {
          "default": 20,
          "maximum": 10000,
          "minimum": 1,
          "title": "Information Capacity",
          "type": "integer"
        },
        "minimum_salience": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum Salience",
          "type": "integer"
        }
      },
      "title": "AttentionProfile",
      "type": "object"
    },
    "BackgroundMarketSector": {
      "additionalProperties": false,
      "properties": {
        "sector_id": {
          "default": "background",
          "title": "Sector Id",
          "type": "string"
        },
        "token_balance": {
          "default": 0,
          "minimum": 0,
          "title": "Token Balance",
          "type": "integer"
        },
        "usdx_balance": {
          "default": 0,
          "minimum": 0,
          "title": "Usdx Balance",
          "type": "integer"
        },
        "participation_policy_id": {
          "default": "background.fixture.v0.1",
          "title": "Participation Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "background-market-sector.v0.1",
          "default": "background-market-sector.v0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "BackgroundMarketSector",
      "type": "object"
    },
    "BasePersona": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "const": "persona.v0.1",
          "default": "persona.v0.1",
          "title": "Template Version",
          "type": "string"
        },
        "private_goals": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Private Goals",
          "type": "array"
        },
        "risk_tolerance_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Risk Tolerance Milli",
          "type": "integer"
        },
        "time_horizon": {
          "enum": [
            "short",
            "medium",
            "long"
          ],
          "title": "Time Horizon",
          "type": "string"
        },
        "loss_aversion_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Loss Aversion Milli",
          "type": "integer"
        },
        "trend_bias_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Trend Bias Milli",
          "type": "integer"
        },
        "skepticism_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Skepticism Milli",
          "type": "integer"
        },
        "communication_propensity_milli": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Communication Propensity Milli",
          "type": "integer"
        },
        "bounded_notes": {
          "default": "",
          "maxLength": 500,
          "title": "Bounded Notes",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "risk_tolerance_milli",
        "time_horizon",
        "loss_aversion_milli",
        "trend_bias_milli",
        "skepticism_milli",
        "communication_propensity_milli"
      ],
      "title": "BasePersona",
      "type": "object"
    },
    "CognitiveProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "cognitive.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "max_plans_per_window": {
          "default": 2,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Plans Per Window",
          "type": "integer"
        },
        "planning_window_us": {
          "default": 300000000,
          "minimum": 1,
          "title": "Planning Window Us",
          "type": "integer"
        },
        "context_capacity": {
          "default": 8000,
          "maximum": 1000000,
          "minimum": 256,
          "title": "Context Capacity",
          "type": "integer"
        },
        "memory_search_limit": {
          "default": 5,
          "maximum": 100,
          "minimum": 0,
          "title": "Memory Search Limit",
          "type": "integer"
        }
      },
      "title": "CognitiveProfile",
      "type": "object"
    },
    "LatencyProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "default": "latency.default.v0.1",
          "title": "Profile Id",
          "type": "string"
        },
        "planning_latency_us": {
          "default": 1000000,
          "minimum": 0,
          "title": "Planning Latency Us",
          "type": "integer"
        },
        "action_latency_us": {
          "default": 1000000,
          "minimum": 0,
          "title": "Action Latency Us",
          "type": "integer"
        }
      },
      "title": "LatencyProfile",
      "type": "object"
    },
    "MarketConfig": {
      "additionalProperties": false,
      "properties": {
        "market_id": {
          "default": "TOKEN-USDX",
          "title": "Market Id",
          "type": "string"
        },
        "base_asset": {
          "default": "TOKEN",
          "title": "Base Asset",
          "type": "string"
        },
        "quote_asset": {
          "default": "USDX",
          "title": "Quote Asset",
          "type": "string"
        },
        "base_scale": {
          "default": 1,
          "minimum": 1,
          "title": "Base Scale",
          "type": "integer"
        },
        "quote_scale": {
          "default": 1,
          "minimum": 1,
          "title": "Quote Scale",
          "type": "integer"
        },
        "price_tick": {
          "default": 1,
          "minimum": 1,
          "title": "Price Tick",
          "type": "integer"
        },
        "maker_fee_bps": {
          "default": 5,
          "maximum": 1000,
          "minimum": 0,
          "title": "Maker Fee Bps",
          "type": "integer"
        },
        "taker_fee_bps": {
          "default": 10,
          "maximum": 1000,
          "minimum": 0,
          "title": "Taker Fee Bps",
          "type": "integer"
        },
        "initial_mid_price": {
          "default": 100,
          "minimum": 1,
          "title": "Initial Mid Price",
          "type": "integer"
        }
      },
      "title": "MarketConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "mode": {
      "enum": [
        "test_fixture",
        "live_llm_smoke",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "preset_version": {
      "title": "Preset Version",
      "type": "string"
    },
    "provider_report": {
      "additionalProperties": true,
      "title": "Provider Report",
      "type": "object"
    },
    "chain_snapshot": {
      "additionalProperties": true,
      "title": "Chain Snapshot",
      "type": "object"
    },
    "market": {
      "$ref": "#/$defs/MarketConfig"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentConfig"
      },
      "title": "Agents",
      "type": "array"
    },
    "agent_definitions": {
      "items": {
        "$ref": "#/$defs/AgentDefinition"
      },
      "title": "Agent Definitions",
      "type": "array"
    },
    "background_market_sector": {
      "$ref": "#/$defs/BackgroundMarketSector"
    },
    "total_supply": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Total Supply",
      "type": "object"
    },
    "preview": {
      "additionalProperties": true,
      "title": "Preview",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "schema_version": {
      "const": "resolved-initial-state.v0.2",
      "default": "resolved-initial-state.v0.2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "name",
    "mode",
    "seed",
    "preset_version",
    "provider_report",
    "chain_snapshot",
    "market",
    "agents",
    "total_supply"
  ],
  "title": "ResolvedInitialState",
  "type": "object"
}
