{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "rule",
            "replay",
            "openai",
            "background"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "title": "Role Tags",
          "type": "array"
        },
        "funding_profile": {
          "title": "Funding Profile",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "token_balance": {
          "minimum": 0,
          "title": "Token Balance",
          "type": "integer"
        },
        "usdx_balance": {
          "minimum": 0,
          "title": "Usdx Balance",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "strategy",
        "funding_profile",
        "token_balance",
        "usdx_balance"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentDefinition": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "public_identity": {
          "default": "",
          "maxLength": 500,
          "title": "Public Identity",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Role Tags",
          "type": "array"
        },
        "funding_profile": {
          "enum": [
            "ordinary",
            "capital",
            "liquidity",
            "issuer",
            "information"
          ],
          "title": "Funding Profile",
          "type": "string"
        },
        "capability_set": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Capability Set",
          "type": "array"
        },
        "base_persona": {
          "$ref": "#/$defs/BasePersona"
        },
        "planner_profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Planner Profile Id",
          "type": "string"
        },
        "controller_profile_id": {
          "default": "declarative_market.v0.1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Controller Profile Id",
          "type": "string"
        },
        "cognitive_profile": {
          "$ref": "#/$defs/CognitiveProfile"
        },
        "attention_profile": {
          "$ref": "#/$defs/AttentionProfile"
        },
        "latency_profile": {
          "$ref": "#/$defs/LatencyProfile"
        },
        "schema_version": {
          "const": "agent-definition.v0.1",
          "default": "agent-definition.v0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "funding_profile",
        "base_persona",
        "planner_profile_id"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentRuntimeState": {
      "additionalProperties": false,
