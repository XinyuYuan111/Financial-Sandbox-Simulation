          "propertyNames": {
            "enum": [
              "memory",
              "belief",
              "planning",
              "strategy",
              "cursor",
              "budget",
              "attention"
            ]
          },
          "title": "Component Revisions",
          "type": "object"
        },
        "active_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Plan Id"
        },
        "active_strategy_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Active Strategy Revision",
          "type": "integer"
        },
        "planning_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
