{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "rule",
            "replay",
            "openai",
            "background"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "role_tags": {
          "items": {
            "type": "string"
          },
          "title": "Role Tags",
          "type": "array"
        },
        "funding_profile": {
          "title": "Funding Profile",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "token_balance": {
          "minimum": 0,
          "title": "Token Balance",
          "type": "integer"
        },
        "usdx_balance": {
          "minimum": 0,
          "title": "Usdx Balance",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "display_name",
        "strategy",
        "funding_profile",
        "token_balance",
        "usdx_balance"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "MarketConfig": {
      "additionalProperties": false,
      "properties": {
        "market_id": {
          "default": "TOKEN-USDX",
          "title": "Market Id",
          "type": "string"
        },
        "base_asset": {
          "default": "TOKEN",
          "title": "Base Asset",
          "type": "string"
        },
        "quote_asset": {
          "default": "USDX",
          "title": "Quote Asset",
          "type": "string"
        },
        "base_scale": {
          "default": 1,
          "minimum": 1,
          "title": "Base Scale",
          "type": "integer"
        },
        "quote_scale": {
          "default": 1,
          "minimum": 1,
          "title": "Quote Scale",
          "type": "integer"
        },
        "price_tick": {
          "default": 1,
          "minimum": 1,
          "title": "Price Tick",
          "type": "integer"
        },
        "maker_fee_bps": {
          "default": 5,
          "maximum": 1000,
          "minimum": 0,
          "title": "Maker Fee Bps",
          "type": "integer"
        },
        "taker_fee_bps": {
          "default": 10,
          "maximum": 1000,
          "minimum": 0,
          "title": "Taker Fee Bps",
          "type": "integer"
        },
        "initial_mid_price": {
          "default": 100,
          "minimum": 1,
          "title": "Initial Mid Price",
          "type": "integer"
        }
      },
      "title": "MarketConfig",
      "type": "object"
    },
    "PopulationConfig": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "default": "fixture",
          "enum": [
            "fixture",
            "smoke",
            "compact",
            "standard"
          ],
          "title": "Preset",
          "type": "string"
        },
        "agent_count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Count"
        }
      },
      "title": "PopulationConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "default": "Framework Alpha fixture",
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "mode": {
      "default": "test_fixture",
      "enum": [
        "test_fixture",
        "live_llm_smoke",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "seed": {
      "default": 20260723,
      "title": "Seed",
      "type": "integer"
    },
    "chain_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chain Id"
    },
    "target_token": {
      "default": "TOKEN",
      "title": "Target Token",
      "type": "string"
    },
    "llm_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Provider"
    },
    "preset_version": {
      "default": "framework-alpha.default.v0.2",
      "title": "Preset Version",
      "type": "string"
    },
    "population": {
      "$ref": "#/$defs/PopulationConfig"
    },
    "market": {
      "$ref": "#/$defs/MarketConfig"
    },
    "agents": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AgentConfig"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agents"
    }
  },
  "title": "ScenarioDraft",
  "type": "object"
}
