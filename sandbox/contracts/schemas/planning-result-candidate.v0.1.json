          "title": "Style",
          "type": "string"
        },
        "max_quantity": {
          "minimum": 1,
          "title": "Max Quantity",
          "type": "integer"
        },
        "max_notional": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Notional"
        },
        "price_offset_bps": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "Price Offset Bps",
          "type": "integer"
        },
        "guard": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOfCondition",
                  "any_of": "#/$defs/AnyOfCondition",
                  "compare": "#/$defs/CompareCondition",
                  "not": "#/$defs/NotCondition"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CompareCondition"
                },
                {
                  "$ref": "#/$defs/AllOfCondition"
                },
                {
                  "$ref": "#/$defs/AnyOfCondition"
                },
                {
                  "$ref": "#/$defs/NotCondition"
                }
              ]
            },
            {
              "type": "null"
            }
