            "communication": "#/$defs/CommunicationDirective",
            "quote": "#/$defs/QuoteDirective",
            "trade": "#/$defs/TradeDirective"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TradeDirective"
          },
          {
            "$ref": "#/$defs/QuoteDirective"
          },
          {
            "$ref": "#/$defs/CancelDirective"
          },
          {
            "$ref": "#/$defs/CommunicationDirective"
          }
        ]
      },
      "maxItems": 32,
      "title": "Directives",
      "type": "array"
