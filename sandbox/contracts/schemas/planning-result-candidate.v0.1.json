    "TradeDirective": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "trade",
          "default": "trade",
          "title": "Type",
          "type": "string"
        },
        "directive_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Directive Key",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "style": {
          "enum": [
            "passive",
            "aggressive",
            "protected_market"
