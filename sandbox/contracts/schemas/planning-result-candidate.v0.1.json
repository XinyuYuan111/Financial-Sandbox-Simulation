  "additionalProperties": false,
  "properties": {
    "based_on_strategy_revision": {
      "minimum": 0,
      "title": "Based On Strategy Revision",
      "type": "integer"
    },
    "valid_for_us": {
      "minimum": 1,
      "title": "Valid For Us",
      "type": "integer"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/Goal"
      },
      "maxItems": 16,
      "title": "Goals",
      "type": "array"
