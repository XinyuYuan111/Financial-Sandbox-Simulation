    "AllOfCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "all_of",
          "default": "all_of",
          "title": "Type",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOfCondition",
                "any_of": "#/$defs/AnyOfCondition",
                "compare": "#/$defs/CompareCondition",
                "not": "#/$defs/NotCondition"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CompareCondition"
              },
              {
                "$ref": "#/$defs/AllOfCondition"
              },
              {
                "$ref": "#/$defs/AnyOfCondition"
              },
              {
                "$ref": "#/$defs/NotCondition"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AllOfCondition",
      "type": "object"
    },
    "AnyOfCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "any_of",
          "default": "any_of",
          "title": "Type",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/AllOfCondition",
                "any_of": "#/$defs/AnyOfCondition",
                "compare": "#/$defs/CompareCondition",
                "not": "#/$defs/NotCondition"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CompareCondition"
              },
              {
                "$ref": "#/$defs/AllOfCondition"
              },
              {
                "$ref": "#/$defs/AnyOfCondition"
              },
              {
                "$ref": "#/$defs/NotCondition"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AnyOfCondition",
      "type": "object"
    },
    "CancelDirective": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cancel",
          "default": "cancel",
          "title": "Type",
          "type": "string"
        },
        "directive_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Directive Key",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "buy",
                "sell"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "plan_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Revision"
        },
        "guard": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOfCondition",
                  "any_of": "#/$defs/AnyOfCondition",
                  "compare": "#/$defs/CompareCondition",
                  "not": "#/$defs/NotCondition"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CompareCondition"
                },
                {
                  "$ref": "#/$defs/AllOfCondition"
                },
                {
                  "$ref": "#/$defs/AnyOfCondition"
                },
                {
                  "$ref": "#/$defs/NotCondition"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guard"
        },
        "emission": {
          "$ref": "#/$defs/EmissionPolicy"
        }
      },
      "required": [
        "directive_key",
        "emission"
      ],
      "title": "CancelDirective",
      "type": "object"
    },
    "CommunicationDirective": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "communication",
          "default": "communication",
          "title": "Type",
          "type": "string"
        },
        "directive_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Directive Key",
          "type": "string"
        },
        "channel": {
          "enum": [
            "PublicFeed",
            "OfficialAnnouncement",
            "TradingTerminal",
            "PrivateChannel"
          ],
          "title": "Channel",
          "type": "string"
        },
        "communication_mode": {
          "default": "disclose",
          "enum": [
            "disclose",
            "withhold"
          ],
          "title": "Communication Mode",
          "type": "string"
        },
        "message_payload": {
          "default": "",
          "maxLength": 4000,
          "title": "Message Payload",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Target Ids",
          "type": "array"
        },
        "signal_direction": {
          "anyOf": [
            {
              "enum": [
                "bullish",
                "bearish",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Direction"
        },
        "signal_confidence_milli": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Confidence Milli"
        },
        "claim_intent": {
          "default": "sincere",
          "enum": [
            "sincere",
            "strategic_deception"
          ],
          "title": "Claim Intent",
          "type": "string"
        },
        "private_assessment_direction": {
          "anyOf": [
            {
              "enum": [
                "bullish",
                "bearish",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Assessment Direction"
        },
        "derived_from_info_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Info Id"
        },
        "guard": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "all_of": "#/$defs/AllOfCondition",
                  "any_of": "#/$defs/AnyOfCondition",
                  "compare": "#/$defs/CompareCondition",
                  "not": "#/$defs/NotCondition"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/CompareCondition"
                },
                {
                  "$ref": "#/$defs/AllOfCondition"
                },
                {
                  "$ref": "#/$defs/AnyOfCondition"
                },
                {
                  "$ref": "#/$defs/NotCondition"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guard"
        },
        "emission": {
          "$ref": "#/$defs/EmissionPolicy"
        }
      },
      "required": [
        "directive_key",
        "channel",
        "emission"
      ],
      "title": "CommunicationDirective",
      "type": "object"
    },
    "CompareCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "compare",
          "default": "compare",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "enum": [
            "market.last_price_tick",
            "market.spread_bps",
            "market.recent_volume",
            "account.free_base",
            "account.free_quote",
            "account.position_base",
            "belief.confidence_milli",
            "observation.has_information_tag",
            "own_action_outcome.code",
            "sim_time_us"
          ],
          "title": "Path",
          "type": "string"
        },
        "op": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "neq",
            "gte",
            "gt",
            "contains"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "path",
        "op",
        "value"
      ],
      "title": "CompareCondition",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "max_order_notional",
            "max_position_base",
            "min_free_quote",
            "allowed_action_count"
          ],
          "title": "Kind",
          "type": "string"
        },
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "amount"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "DecisionRationale": {
      "additionalProperties": false,
      "properties": {
        "goal_summary": {
          "default": "",
          "maxLength": 500,
          "title": "Goal Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Ids",
          "type": "array"
        },
        "belief_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Belief Ids",
          "type": "array"
        },
        "strategy_revision": {
          "default": 0,
          "minimum": 0,
          "title": "Strategy Revision",
          "type": "integer"
        },
        "risk_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Risk Flags",
          "type": "array"
        },
        "uncertainty_milli": {
          "default": 500,
          "maximum": 1000,
          "minimum": 0,
          "title": "Uncertainty Milli",
          "type": "integer"
        },
        "proposal_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Proposal Ids",
          "type": "array"
        },
        "stated_reason": {
          "default": "",
          "maxLength": 1000,
          "title": "Stated Reason",
          "type": "string"
        }
      },
      "title": "DecisionRationale",
      "type": "object"
    },
    "EmissionPolicy": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "once",
            "on_guard_transition",
            "periodic",
            "while_guarded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "max_emissions": {
          "default": 1,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Emissions",
          "type": "integer"
        },
        "interval_us": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Us"
        },
        "cooldown_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown Us"
        }
      },
      "required": [
        "mode"
      ],
      "title": "EmissionPolicy",
      "type": "object"
    },
    "Goal": {
      "additionalProperties": false,
      "properties": {
        "goal_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Goal Key",
          "type": "string"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "goal_key",
        "priority"
      ],
      "title": "Goal",
      "type": "object"
    },
    "NotCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "not",
          "default": "not",
